# Hosts and URLs the link checker should skip.
#
# These are not dead. They either block automated requests outright or only
# exist at request time, so checking them produces noise rather than signal.
# Verify anything added here by hand before adding it.

# Example URL used throughout the docs as placeholder payload content.
^https?://example\.com

# Local dev server referenced in the "run the web app" instructions.
^https?://localhost
^https?://127\.0\.0\.1

# Placeholder in the clone/remote instructions.
YOUR_USERNAME

# Cloudflare / bot protection. All verified live by hand.
^https?://(www\.)?reddit\.com
^https?://(www\.)?acs\.com\.hk
^https?://forum\.dangerousthings\.com

# Store pages rate limit aggressively from CI runners.
^https?://play\.google\.com
^https?://apps\.apple\.com
